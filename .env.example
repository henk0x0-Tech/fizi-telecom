# ═══════════════════════════════════════════════════════
#  FIZI TELECOM — .env.example
#  Copy this to .env and fill in real values.
#  NEVER commit .env to git.
# ═══════════════════════════════════════════════════════

# ── MongoDB ───────────────────────────────────────────
# Local dev: mongodb://localhost:27017/fizi-telecom
# Production: MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/fizi-telecom?retryWrites=true&w=majority
MONGODB_NAME=fizi-telecom

# ── Server ────────────────────────────────────────────
SERVER_PORT=5000
SERVER_HOST=0.0.0.0
NODE_ENV=production

# ── JWT ───────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_STRONG_RANDOM_SECRET_64_CHARS_MIN

# ── CORS: the Netlify frontend URL ────────────────────
CLIENT_URL=https://fizitelecom.netlify.app

# ── Client (Vite) — set in Netlify UI or .env.local ──
# Leave empty for production (Netlify proxy /api/* handles it)
# For local dev: http://localhost:5000/api
VITE_API_URL=

# Backend URL used by Netlify netlify.toml proxy
# Set this in Netlify UI Environment Variables
VITE_API_BASE_URL=https://your-backend.onrender.com

# ── Email (optional) ──────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
